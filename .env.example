# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Logging
LOG_LEVEL=info
ACCESS_LOG_ENABLED=true

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=movie_hub

# Redis sessions (use rediss:// for TLS)
REDIS_URL=
REDIS_KEY_PREFIX=movie_hub:
SESSION_COOKIE_NAME=movie_hub_session
SESSION_TTL_SECONDS=2592000
SESSION_TOKEN_PEPPER=
SESSION_COOKIE_SECURE=false
REGISTRATION_USER_LIMIT=100

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# MinIO avatar storage
# Hostname/IP only. Configure the port and TLS separately below.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=movie-hub-avatars
MINIO_REGION=
MINIO_PUBLIC_BASE_URL=
AVATAR_MAX_BYTES=52428800
AVATAR_MAX_PIXELS=16777216

# Integration credentials (required; use a dedicated random value of at least 32 characters)
INTEGRATION_SECRET_KEY=replace-with-an-independent-random-secret
MTEAM_ALLOWED_HOSTS=api.m-team.cc,api.m-team.io
MTEAM_REQUEST_TIMEOUT_MS=10000
MTEAM_RESOURCE_AVAILABLE_TTL_SECONDS=86400
MTEAM_RESOURCE_UNAVAILABLE_TTL_SECONDS=21600
MTEAM_RESOURCE_RETRY_DELAY_SECONDS=900
MTEAM_RESOURCE_CHECK_LEASE_SECONDS=120
MTEAM_SEARCH_MIN_INTERVAL_MS=2500
MTEAM_RELEASE_CACHE_TTL_SECONDS=120

# TMDB
# Accepts either a v4 API Read Access Token or a 32-character v3 API Key.
TMDB_READ_ACCESS_TOKEN=
TMDB_LANGUAGE=zh-CN
TMDB_REQUEST_TIMEOUT_MS=10000
SYNC_SCHEDULER_ENABLED=true
SYNC_SCHEDULER_POLL_INTERVAL_MS=60000
SYNC_JOB_LEASE_SECONDS=600
SYNC_JOB_RETRY_BASE_SECONDS=300
SYNC_JOB_RETRY_MAX_SECONDS=3600
TRENDING_SYNC_INTERVAL_SECONDS=3600
TRENDING_SYNC_PAGES=3
TRENDING_SYNC_CONCURRENCY=3
TRENDING_SYNC_LOCK_TTL_SECONDS=300

# Web
VITE_API_BASE_URL=/api/v1
