# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Logging
LOG_LEVEL=info
ACCESS_LOG_ENABLED=true
VERBOSE=false
# Global resource discovery notification interval (3 hours)
RESOURCE_NOTIFICATION_INTERVAL_MS=10800000

# Experimental pages: always disabled in production, regardless of these flags.
PAGE_AI_ASSISTANT_ENABLED=true

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=movie_hub

# Redis sessions (use rediss:// for TLS)
REDIS_URL=
REDIS_KEY_PREFIX=movie_hub:
SESSION_COOKIE_NAME=movie_hub_session
SESSION_TTL_SECONDS=2592000
SESSION_TOKEN_PEPPER=
SESSION_COOKIE_SECURE=false
REGISTRATION_USER_LIMIT=100

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# MinIO avatar storage
# Hostname/IP only. Configure the port and TLS separately below.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=movie-hub-avatars
MINIO_REGION=
MINIO_PUBLIC_BASE_URL=
AVATAR_MAX_BYTES=52428800
AVATAR_MAX_PIXELS=16777216

# Integration credentials (required; use a dedicated random value of at least 32 characters)
INTEGRATION_SECRET_KEY=replace-with-an-independent-random-secret
MTEAM_ALLOWED_HOSTS=api.m-team.cc,api.m-team.io
MTEAM_REQUEST_TIMEOUT_MS=10000
MTEAM_RESOURCE_AVAILABLE_TTL_SECONDS=86400
MTEAM_RESOURCE_UNAVAILABLE_TTL_SECONDS=21600
MTEAM_RESOURCE_RETRY_DELAY_SECONDS=900
MTEAM_RESOURCE_CHECK_LEASE_SECONDS=120
MTEAM_SEARCH_MIN_INTERVAL_MS=2500

# Shared Redis release-list cache for M-Team and other resource sites (30 minutes)
RESOURCE_RELEASE_CACHE_TTL_SECONDS=1800

# TMDB
# Accepts either a v4 API Read Access Token or a 32-character v3 API Key.
TMDB_READ_ACCESS_TOKEN=
TMDB_LANGUAGE=zh-CN
MEDIA_TRENDING_CACHE_TTL_SECONDS=900
TMDB_REQUEST_TIMEOUT_MS=10000
SYNC_SCHEDULER_ENABLED=true
SYNC_SCHEDULER_POLL_INTERVAL_MS=60000
SYNC_JOB_LEASE_SECONDS=600
SYNC_JOB_RETRY_BASE_SECONDS=300
SYNC_JOB_RETRY_MAX_SECONDS=3600

# Web
VITE_API_BASE_URL=/api/v1

# Telegram private notifications (optional). One dedicated Bot per deployment.
# Keep this Bot free of external getUpdates consumers and webhooks.
# TELEGRAM_BOT_TOKEN=123456789:your_bot_token

# Assistant worker: use the same concurrency limit on every API instance.
ASSISTANT_MAX_CONCURRENCY=4
# Recovery scan only; normal inbound messages wake the worker immediately.
ASSISTANT_SCAN_INTERVAL_MS=15000

# Maximum time for graceful API shutdown before forcing exit with failure.
SHUTDOWN_TIMEOUT_MS=30000

# Verbose Redis lock acquisition, renewal, checkpoint and release tracing.
REDIS_LOCK_TRACE_ENABLED=false

# Trace routine Telegram polling; message processing and failures remain logged.
TELEGRAM_POLL_TRACE_ENABLED=false

# Trace routine recovery, notification and usage aggregation scans.
SCAN_TRACE_ENABLED=false

# Curated OpenAI text models, ordered for display. Intersected with the saved key model list.
# Add model IDs here and restart the API. Empty means no recommended choices.
OPENAI_RECOMMENDED_MODELS=gpt-6.1-sol,gpt-6-astra,gpt-6-sol,gpt-6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.4-nano,gpt-5.2,gpt-5.1,gpt-5,gpt-5-mini,gpt-5-nano
OPENAI_MODEL=gpt-5.6-sol

# Resource site endpoints (restart API after changes) / 资源站点地址（修改后重启 API）
HDAREA_BASE_URL=https://hdarea.club
MTEAM_BASE_URL=https://api.m-team.cc
MTEAM_WEB_BASE_URL=https://kp.m-team.cc

# Popular initiates a bidirectional WebSocket pool to this Gateway origin.
# REMOTE_GATEWAY_SERVICE_TOKEN must equal Gateway INTERNAL_INBOUND_TOKEN.
# Never use remote_client_api_key here. Leave both empty to configure later.
REMOTE_GATEWAY_BASE_URL=
REMOTE_GATEWAY_SERVICE_TOKEN=
REMOTE_GATEWAY_POOL_SIZE=4

# Registration verification: 24-hour expiry, at most 100 email attempts per rolling 24 hours.
MAILGUN_API_KEY=
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=mail.gofloat.cn
MAILGUN_FROM="Popular <noreply@mail.gofloat.cn>"
