{
  "name": "@movie-hub/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./socket-rpc": {
      "types": "./dist/helper-gateway/socket-rpc.service.d.ts",
      "default": "./dist/helper-gateway/socket-rpc.service.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "patch": "pnpm version patch",
    "minor": "pnpm version minor",
    "major": "pnpm version major",
    "beta": "pnpm version prerelease --preid beta",
    "alpha": "pnpm version prerelease --preid alpha",
    "rc": "pnpm version prerelease --preid rc"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
