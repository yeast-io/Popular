{
  "name": "@movie-hub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "sync:trending": "node dist/jobs/sync-trending.js",
    "migrate:movie-locales": "node dist/jobs/migrate-movie-locales.js",
    "reset:movies": "node dist/jobs/reset-movie-catalog.js",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@movie-hub/contract": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.1",
    "minio": "^8.0.6",
    "mongoose": "^8.19.1",
    "openai": "^7.34.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
