{
  "name": "@movie-hub/api",
  "version": "1.0.1-beta.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "reset:movies": "node dist/jobs/reset-movie-catalog.js",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "patch": "pnpm version patch",
    "minor": "pnpm version minor",
    "major": "pnpm version major",
    "beta": "pnpm version prerelease --preid beta",
    "alpha": "pnpm version prerelease --preid alpha",
    "rc": "pnpm version prerelease --preid rc"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@langchain/langgraph": "^1.5.1",
    "@movie-hub/contract": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.1",
    "minio": "^8.0.6",
    "mongoose": "^8.19.1",
    "openai": "^7.34.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "tough-cookie": "^6.0.2",
    "ws": "^8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
