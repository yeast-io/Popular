{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Popular Link Agent",
  "version": "0.1.1-beta.4",
  "identifier": "com.popular.helper-agent",
  "build": {
    "beforeDevCommand": "pnpm dev:ui",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "visible": false,
        "title": "Agent",
        "width": 1040,
        "height": 820,
        "minWidth": 540,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
