# Exact browser-facing origin; use https:// behind a TLS reverse proxy.
AGENT_WEB_ORIGIN=http://127.0.0.1:1423
AGENT_SESSION_TTL_SECONDS=28800
VERBOSE=false
LOG_LEVEL=info
# Compose host publishing only (container bind remains 0.0.0.0:1423).
AGENT_PUBLISH_ADDRESS=127.0.0.1
AGENT_WEB_PORT=1423
# Credentials are generated in files by --init-secrets, never in this file.
