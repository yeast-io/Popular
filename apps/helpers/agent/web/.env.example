# Optional overrides. compose.yaml works without this file.
AGENT_IMAGE=ghcr.io/yeast-io/popular-agent:0.1.1-beta.1-647526a803ef
AGENT_PUBLISH_ADDRESS=127.0.0.1
AGENT_WEB_PORT=1423

# For LAN/NAS: set AGENT_PUBLISH_ADDRESS=0.0.0.0 above and uncomment
# AGENT_WEB_ORIGIN below, using the Docker host's actual IP and port.
# AGENT_WEB_ORIGIN=http://192.168.1.10:1423

# Optional absolute host paths; otherwise Docker named volumes are used.
# Pre-create both directories with ownership 10001:10001 and mode 700.
# Keep existing data and master keys together when migrating storage.
# AGENT_DATA_MOUNT=/srv/popular-agent/data
# AGENT_SECRETS_MOUNT=/srv/popular-agent/secrets

AGENT_SESSION_TTL_SECONDS=28800
VERBOSE=false
LOG_LEVEL=info
# Optional single administrator login. Set BOTH values; password: 8–4096 bytes.
# Empty/unset values for both use the automatically generated admin-password file.
# WEB_LOGIN_USER=admin
# WEB_LOGIN_PASSWORD=replace-with-a-long-private-password
# master.key is generated once on a new installation; preserve the secrets volume.
